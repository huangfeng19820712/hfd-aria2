# 共享配置文件 —— 脚本和 hfd-web 容器都读这一份
#
# 位置：与 hfd-aria2.sh 同目录
#
# 优先级：命令行 export > 容器 environment > 本文件
# （本文件只在变量未被设置时才生效）
#
# 必须 LF 行尾（不能有 ^M）。从 Windows 编辑过请执行：
#   sed -i 's/\r$//' hfd-aria2.env

# ---- Hugging Face ----
# HF_ENDPOINT 默认就是 hf-mirror.com，国内直连 huggingface.co 会超时。
HF_ENDPOINT=https://hf-mirror.com

# HF_TOKEN 可选：公共模型不需要。
# 需要时才取消注释并填入真实 token（私有 / gated 模型必须有）。
# 警告：填了占位符（hf_xxx）会被当成真 token 发出去，导致 401 和
#       重定向到错误的 CDN 域名。宁可留空。
# HF_TOKEN=hf_xxxxxxxxxxxxxxxx

# ---- aria2 RPC ----
# 用 NAS 的局域网 IP：本机和容器都能访问。
# 不要用 127.0.0.1（容器里的 localhost 是它自己，不是 aria2）。
# 部署到别的机器时改成对应的 IP。
ARIA2_RPC=http://192.168.1.252:6800/jsonrpc
ARIA2_SECRET=your_aria2_secret_here

# ---- 下载目录 ----
# 容器内路径。需与 docker-compose.yml 里 /downloads 的挂载源对应。
ARIA2_DIR_PREFIX=/downloads/models

# ---- AriaNg ----
# 留空则按请求 Host 自动推断（推荐，换 IP 不用改）。
ARIA2_WEB_URL=

# ---- 脚本行为 ----
# 1 = 等所有下载完成后脚本才退出（默认 0：addUri 完即退出）
# HFD_WAIT=0
# 1 = 打印每个文件的解析详情
# HFD_DEBUG=0
