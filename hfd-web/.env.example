# hfd-web 配置文件示例
# 复制为 .env 并填入实际值，docker compose 会自动读取
# 注意：文件必须是 LF 行尾（不能有 ^M），否则变量值会带上回车符

# HF 镜像（国内推荐 hf-mirror.com）
HF_ENDPOINT=https://hf-mirror.com

# HF Token（hf-mirror.com API 必填；huggingface.co 公共模型可省）
HF_TOKEN=hf_xxxxxxxxxxxxxxxx

# aria2 RPC 地址（必须是容器能访问到的地址）
# - aria2 容器在同机：写 NAS 内网 IP，如 http://192.168.1.100:6800/jsonrpc
# - 用 ip addr | grep inet 查 NAS 内网 IP
# - 不要写 127.0.0.1（容器里的 localhost 是 hfd-web 自己）
ARIA2_RPC=http://192.168.1.100:6800/jsonrpc

# aria2 RPC token（必须与 aria2.conf 的 rpc-secret 一致）
ARIA2_SECRET=your_aria2_secret_here

# aria2 下载根目录（容器内路径），默认 /downloads/models
# 需与 docker-compose.yml 里 /downloads 的挂载源保持同一套路径
ARIA2_DIR_PREFIX=/downloads/models

# AriaNg 跳转 URL（留空则自动从请求 Host 推断）
ARIA2_WEB_URL=http://192.168.1.100:6880